{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ERD-Ultra",
  "version": "0.1.0",
  "identifier": "io.github.gigafrosxh.erdultra",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ERD-Ultra",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "ER-Diagramme, relationale Schemas und Testdaten",
    "longDescription": "ERD-Ultra erstellt ER-Diagramme in Chen-Notation grafisch oder per Code, bildet sie auf relationale Schemas ab und generiert Testdaten.",
    "copyright": "© gigafrosxh",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "erdu"
        ],
        "name": "ERD-Ultra Projekt",
        "description": "ERD-Ultra Projektdatei",
        "mimeType": "application/x-erd-ultra",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg2MTUwMTcwMDQ5MjBDOUIKUldTYkRKSUVjQUVWaHZ1L1Y5S1FBcW85blhGQndmVnJvYUlJTUpYUnY1OElxK3lDc0lzQTVndFAK",
      "endpoints": [
        "https://github.com/gigafrosxh/erd-ultra/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
